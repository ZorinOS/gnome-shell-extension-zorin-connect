# SPDX-FileCopyrightText: Zorin Connect Developers https://github.com/ZorinOS/gnome-shell-extension-zorin-connect
#
# SPDX-License-Identifier: GPL-2.0-or-later

fallback_dir=$HOME/.local/share/gnome-shell/extensions/zorin-connect@zorinos.com/

if [ ! -f "./zorin-connect-preferences.js" ]; then
    # Try to find home path
    extension_dir="$(dirname "$(realpath "$(command -v "$0")")")"
    # try even harder
    if [ ! -d "$extension_dir" ]; then
        extension_dir="$fallback_dir"
    fi
    cd "$extension_dir" || exit 1
fi
exec /usr/bin/env gjs -m zorin-connect-preferences.js

